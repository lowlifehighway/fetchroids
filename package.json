{
  "name": "fetchroids",
  "version": "2.0.0",
  "description": "A fetch wrapper package to modernize fetch",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "fetchroids",
    "fetch",
    "wrapper",
    "modern",
    "network",
    "client",
    "api",
    "browser",
    "request",
    "http"
  ],
  "author": "Victor Ayoola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lowlifehighway/fetchroids.git"
  },
  "homepage": "https://github.com/lowlifehighway/fetchroids#readme",
  "bugs": {
    "url": "https://github.com/lowlifehighway/fetchroids/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
